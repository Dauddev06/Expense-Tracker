# Copy this file to .env.local for local development:   cp .env.example .env.local
# Never put real passwords for a hosted database in this file - it is committed to git.

# ---------------------------------------------------------------------------
# Local development (the Postgres from docker-compose.yml)
# Used when DATABASE_URL is NOT set.
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=spender
DB_PASSWORD=spender_pass
DB_NAME=spendings_db

# ---------------------------------------------------------------------------
# Hosted database (Vercel + Neon)
# When DATABASE_URL is set it is used INSTEAD of the DB_* values above.
# Leave these commented out locally.
# ---------------------------------------------------------------------------
# One connection string: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# DATABASE_URL=

# "true" = use an encrypted (SSL) connection. Hosted Postgres like Neon requires it.
# Anything else (or not set) = no SSL, which is what local Docker needs.
# DB_SSL=true

# How many database connections each server process may open (default 10).
# On Vercel every serverless function has its own pool, so keep it small there.
# DB_POOL_MAX=3
